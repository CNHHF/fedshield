# 统一换行符：避免 Windows / macOS / Linux 协作时出现整文件 diff
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary
*.mp4 binary
*.db binary
*.woff binary
*.woff2 binary

# 平台脚本保留 CRLF，避免 Windows 下批处理执行异常
*.bat text eol=crlf
*.cmd text eol=crlf

# 语言统计（GitHub Linguist）
*.py       linguist-language=Python
*.vue      linguist-language=Vue
*.js       linguist-language=JavaScript
*.css      linguist-language=CSS
docs/*.md  linguist-documentation
